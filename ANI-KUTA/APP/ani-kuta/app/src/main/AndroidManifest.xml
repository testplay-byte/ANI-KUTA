<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Haptic feedback for pull-to-refresh threshold crossing.
         View.performHapticFeedback() works without this on AOSP, but some OEMs
         gate it behind VIBRATE. Declared defensively (zero risk). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- D-577 (round 83): REQUIRED for the system uninstall prompt. Without it
         the platform UninstallerActivity starts and IMMEDIATELY finishes with
         no dialog and no error (exactly the device log signature:
         UninstallerActivity → FINISHING ~70ms later, nothing on screen).
         REQUEST_INSTALL_PACKAGES covers installs only — uninstalls are gated
         by this separate permission, and the ExtensionInstaller's
         ACTION_DELETE ladder silently no-ops without it. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- D-443: the smart-link ad's floating return pill — a system overlay
         window so the countdown + "Go back" pill floats over the USER'S
         BROWSER while the sponsor visit runs. Runtime-gated by
         Settings.canDrawOverlays(): users who never grant "Display over
         other apps" simply get the previous no-pill behavior (the ad flow
         itself is never blocked on this). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- D-193 Phase 4: Battery optimization — needed for background notifications when app is killed -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- D-315: saving cover images to the gallery (Pictures/ANI-KUTA) on
         API 24–28. API 29+ uses MediaStore RELATIVE_PATH — no permission.
         tools:replace: the bundled aniyomi-mpv-lib declares the same permission
         with maxSdkVersion=32; ours (28) is the correct scoped value. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:replace="android:maxSdkVersion" />

    <!-- Package visibility for the uninstall intent (Android 11+).
         Without this, resolveActivity() returns null for ACTION_DELETE even
         though startActivity() succeeds — but we don't guard with resolveActivity
         anymore. Declared defensively anyway. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DELETE" />
            <data android:scheme="package" />
        </intent>
    </queries>

    <application
        android:name=".AnikutaApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ANIKUTA"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ANIKUTA">
            <!-- D-562 (round 74 — the REAL launcher-icon switch): the MAIN/
                 LAUNCHER intent-filter moved OFF MainActivity onto the 7
                 activity aliases below (.icons.IconDefault + one per baked
                 preset) — the launcher entry is an alias whose android:icon
                 the App Icon page switches via
                 PackageManager.setComponentEnabledSetting (the new alias is
                 enabled BEFORE the old one is disabled — the app never has
                 zero enabled launcher entries). This is the proven D-417
                 shape, re-ordered by the user after the D-434 in-app-only
                 rework turned out to be unable to move the real icon
                 ("the app icon should actually be changed for the
                 application"). The deep-link + OAuth filters stay right
                 here on the activity itself (aliases are never the target
                 of anything — they only carry the launcher entry). -->
            <!-- D-220: AniList OAuth2 implicit grant redirect. -->
            <!-- AniList redirects to anikuta://anilist-auth#access_token=... -->
            <!-- The token is in the URL fragment (not query). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="anikuta" android:host="anilist-auth" />
            </intent-filter>
        </activity>

        <!-- D-562 (round 74): the launcher ICON ALIASES — the default
             (IconDefault, the app's own artwork) plus one per BAKED preset
             (Dark / Teal / Sky / Gold / Green / Pink — the six
             user-provided colorways). IconDefault is the ONLY enabled
             alias; the presets ship disabled until the App Icon page
             (Settings → Appearance → App Icon) enables one. Component
             class names resolve against the NAMESPACE (com.confused.anikuta),
             NOT the applicationId — the .debug suffixed build resolves the
             SAME class strings; AppIconController constructs
             ComponentName(context.packageName, "com.confused.anikuta.icons.Icon…")
             — suffix-safe by construction (the same reasoning verified
             against the built APK at D-417). The debug build's default
             shows the mascot via the app/src/debug/res overlay; the preset
             icons are shared by both build types. Each preset resolves to
             an ADAPTIVE icon on API 26+ (full-bleed artwork background +
             the shared empty foreground, exactly the default icon's
             structure) and to a plain bitmap on API 24–25 (minSdk 24 —
             the legacy fallback is mandatory, an adaptive-icon XML alone
             cannot inflate below 26). -->
        <activity-alias
            android:name=".icons.IconDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icons.IconDark"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_dark"
            android:roundIcon="@mipmap/ic_launcher_dark"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icons.IconTeal"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_teal"
            android:roundIcon="@mipmap/ic_launcher_teal"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icons.IconSky"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_sky"
            android:roundIcon="@mipmap/ic_launcher_sky"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icons.IconGold"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_gold"
            android:roundIcon="@mipmap/ic_launcher_gold"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icons.IconGreen"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_green"
            android:roundIcon="@mipmap/ic_launcher_green"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icons.IconPink"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pink"
            android:roundIcon="@mipmap/ic_launcher_pink"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Crash handler error screen (shown when app crashes) -->
        <activity
            android:name=".error.ErrorActivity"
            android:exported="false"
            android:theme="@style/Theme.ANIKUTA"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode" />

        <!-- D-209: Cloudflare manual solver WebView Activity.
             Launched from (a) the Extension Detail screen's "Open in WebView"
             button, and (b) the Search/Details error cards when the headless
             CloudflareInterceptor fails (e.g. interactive Turnstile challenges).
             The WebView shares the system CookieManager singleton with the
             OkHttp AndroidCookieJar, so cf_clearance captured here is replayed
             on the next extension HTTP request automatically. -->
        <activity
            android:name=".webview.CloudflareWebViewActivity"
            android:exported="false"
            android:theme="@style/Theme.ANIKUTA"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode" />

        <!-- Task 58 (round 18 — the plugin-share receiver) / Task 59 (round 19):
             exported so other apps (file managers, chat apps) can hand us
             shared .WHITECAT plugin files. Android can't match intent filters
             on FILE EXTENSIONS for content:// URIs, so the filters are
             deliberately MIME-based: unknown-extension files (incl. .bin —
             renamed in transit by share targets) resolve to
             application/octet-stream (and .cs3/.WHITECAT zips to
             application/zip) — the ACTIVITY validates CONTENT-FIRST (Task 59:
             the zip's manifest.json + pluginClassName; the display name's
             extension is only an identity hint) and rejects anything else
             gracefully ("not a plugin file"). Covers:
             - ACTION_VIEW (open from a file manager / download) — content +
               file schemes, octet-stream + zip;
             - ACTION_SEND (shared directly into ANI-KUTA) — octet-stream. -->
        <activity
            android:name=".pluginimport.PluginImportActivity"
            android:exported="true"
            android:theme="@style/Theme.ANIKUTA"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/octet-stream" />
                <data android:scheme="file" android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/zip" />
                <data android:scheme="file" android:mimeType="application/zip" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- Extension install foreground service (Phase 5a) -->
        <service
            android:name="com.confused.anikuta.data.extension.installer.ExtensionInstallService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- App self-update download foreground service.
             Keeps the download alive when the app is killed from recents.
             Shares NOTIFICATION_ID 9999 with UpdateNotificationManager so the
             service's startForeground notification and the manager's progress
             updates merge into a single shade notification. -->
        <service
            android:name="com.confused.anikuta.core.appupdate.UpdateDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Phase UP: Disable default WorkManagerInitializer (we use Configuration.Provider) -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- FileProvider for sharing downloaded APK files with the system
             package installer (:core:app-update → ApkInstaller). Exposes
             cacheDir/updates/ + cacheDir root. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
