<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Haptic feedback for pull-to-refresh threshold crossing.
         View.performHapticFeedback() works without this on AOSP, but some OEMs
         gate it behind VIBRATE. Declared defensively (zero risk). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- D-193 Phase 4: Battery optimization — needed for background notifications when app is killed -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Package visibility for the uninstall intent (Android 11+).
         Without this, resolveActivity() returns null for ACTION_DELETE even
         though startActivity() succeeds — but we don't guard with resolveActivity
         anymore. Declared defensively anyway. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DELETE" />
            <data android:scheme="package" />
        </intent>
    </queries>

    <application
        android:name=".AnikutaApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ANIKUTA"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:theme="@style/Theme.ANIKUTA">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Crash handler error screen (shown when app crashes) -->
        <activity
            android:name=".error.ErrorActivity"
            android:exported="false"
            android:theme="@style/Theme.ANIKUTA"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode" />

        <!-- Extension install foreground service (Phase 5a) -->
        <service
            android:name="com.confused.anikuta.data.extension.installer.ExtensionInstallService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Phase UP: Disable default WorkManagerInitializer (we use Configuration.Provider) -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
