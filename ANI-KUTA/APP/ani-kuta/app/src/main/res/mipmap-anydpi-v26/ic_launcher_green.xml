<?xml version="1.0" encoding="utf-8"?>
<!-- D-562 (round 74): the baked green preset launcher icon — the SAME
     full-bleed adaptive structure as the default icon (the artwork is the
     background layer, the foreground stays empty so the launcher's own
     shape mask crops nothing we care about). The artwork is the baked
     512px drawable (drawable-nodpi/preset_icon_green.jpg). The plain
     mipmap-xxxhdpi/ic_launcher_green.jpg is the API 24–25 legacy fallback
     (an adaptive-icon XML cannot inflate below 26 — minSdk is 24). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/preset_icon_green" />
    <foreground android:drawable="@mipmap/ic_launcher_fg_none" />
</adaptive-icon>
