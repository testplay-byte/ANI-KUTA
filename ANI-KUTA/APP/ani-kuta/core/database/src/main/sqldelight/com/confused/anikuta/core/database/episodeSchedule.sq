-- Episode schedule (Phase SC — PLAN §1.5)
-- Schedule data for upcoming episode airings (AniList airing schedule).
-- scheduled_at = AniList airingAt (the PLANNED time).
-- actual_at = the ACTUAL release time (null until detected by UpdateEngine).

CREATE TABLE IF NOT EXISTS episode_schedule (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    main_id TEXT NOT NULL,               -- FK → main_entry(main_id)
    anilist_id INTEGER,                  -- for the AniList airing API
    episode_number REAL NOT NULL,
    scheduled_at INTEGER NOT NULL,       -- AniList airingAt (epoch millis) — the PLANNED time
    actual_at INTEGER,                   -- the ACTUAL release time (null until detected; IM11: uses source dateUpload)
    audio_variant TEXT NOT NULL DEFAULT 'unknown',  -- CF7: NOT NULL (nullable breaks UNIQUE dedup)
    source TEXT NOT NULL DEFAULT 'anilist',  -- 'anilist' | 'extension' | 'manual' (IM5: dropped confidence)
    fetched_at INTEGER NOT NULL,
    FOREIGN KEY (main_id) REFERENCES main_entry(main_id) ON DELETE CASCADE
);

CREATE UNIQUE INDEX IF NOT EXISTS idx_schedule_unique ON episode_schedule(main_id, episode_number, audio_variant);
CREATE INDEX IF NOT EXISTS idx_schedule_at ON episode_schedule(scheduled_at);
-- NOTE: idx_schedule_main was dropped (Phase DB-OPT) — redundant with the
-- leftmost column (main_id) of idx_schedule_unique UNIQUE composite.

-- Upsert a schedule entry.
upsertEpisodeSchedule:
INSERT OR REPLACE INTO episode_schedule(
    main_id, anilist_id, episode_number, scheduled_at, actual_at, audio_variant, source, fetched_at
) VALUES (
    :main_id, :anilist_id, :episode_number, :scheduled_at, :actual_at, :audio_variant, :source, :fetched_at
);

-- Get upcoming schedule entries (scheduled_at >= now), ordered ascending.
-- D-236: semi-join via EXISTS so only library anime appear in the schedule
-- (prevents non-library anime that were merely opened from leaking in).
-- D-381 (round 25 crash fix): the previous INNER JOIN DUPLICATED every schedule
-- row once per library_item row — and library_item is one row PER CATEGORY
-- (idx_library_item_unique is (main_id, category_id)), so an anime in two
-- categories produced two identical rows → duplicate LazyColumn keys
-- ("mainId_ep_scheduledAt") → IllegalArgumentException crash in the Schedule
-- list. EXISTS is a semi-join: at most one match, no duplication.
getUpcomingSchedule:
SELECT es.* FROM episode_schedule es
WHERE es.scheduled_at >= :from AND es.scheduled_at <= :to
  AND EXISTS (SELECT 1 FROM library_item li WHERE li.main_id = es.main_id)
ORDER BY es.scheduled_at ASC;

-- D-193 Phase 6: Get today's already-aired entries (for grayed-out display at top).
-- D-236 + D-381: EXISTS semi-join (same dedup fix as getUpcomingSchedule).
getTodayAiredSchedule:
SELECT es.* FROM episode_schedule es
WHERE es.scheduled_at >= :dayStart AND es.scheduled_at < :now
  AND EXISTS (SELECT 1 FROM library_item li WHERE li.main_id = es.main_id)
ORDER BY es.scheduled_at DESC;

-- Get schedule entries for a specific day (for the calendar day-detail sheet).
-- D-236 + D-381: EXISTS semi-join (same dedup fix as getUpcomingSchedule).
getScheduleForDay:
SELECT es.* FROM episode_schedule es
WHERE es.scheduled_at >= :dayStart AND es.scheduled_at < :dayEnd
  AND EXISTS (SELECT 1 FROM library_item li WHERE li.main_id = es.main_id)
ORDER BY es.scheduled_at ASC;

-- Get schedule entries for a specific anime.
getScheduleByMainId:
SELECT * FROM episode_schedule WHERE main_id = ? ORDER BY scheduled_at ASC;

-- Update the actual_at (when UpdateEngine finds the episode on a source — Phase SC-2).
updateActualAt:
UPDATE episode_schedule
SET actual_at = :actual_at
WHERE main_id = :main_id AND episode_number = :episode_number;

-- Delete old schedule entries (cleanup).
deleteOldSchedule:
DELETE FROM episode_schedule WHERE scheduled_at < :cutoff;

-- Get all schedule entries (for backup).
getAllSchedule:
SELECT * FROM episode_schedule;
