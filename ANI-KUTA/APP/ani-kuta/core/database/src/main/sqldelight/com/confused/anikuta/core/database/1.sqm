-- ROUND 127 (D-789): the first VERSIONED schema migration (v1 → v2).
--
-- Until this file existed, the schema version was pinned at 1 and every
-- historical change was applied by DatabaseDriverFactory.migrateSchemaIfNeeded's
-- guarded on-open probes (which remain as a safety net). From here on, real
-- schema changes go through .sqm files: this one upgrades every existing
-- install (all stamped user_version = 1) to version 2.
--
-- watch_progress.played_time_ms — the CUMULATIVE actually-played milliseconds
-- across all sessions (the auto-mark's second condition, per the user's spec:
-- watched = fraction threshold AND >= 1 minute actually played, TOTALLED over
-- sessions — not per-session). Existing rows start at 0: their past watching
-- happened before the accumulator existed, so the next genuine session builds
-- the total from zero honestly. Fresh installs get the column from the .sq
-- directly and never run this file.

ALTER TABLE watch_progress ADD COLUMN played_time_ms INTEGER NOT NULL DEFAULT 0;
