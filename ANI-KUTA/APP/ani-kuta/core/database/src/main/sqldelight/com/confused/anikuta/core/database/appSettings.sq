-- ============================================================================
-- App Settings (D-192)
-- A single key-value table for ALL app settings, designed for backup/restore.
-- The primary quick-access layer is PreferenceStore (SharedPreferences).
-- This table is a persistent mirror for backup/restore + cross-device sync.
--
-- Design:
-- - key: unique setting key (e.g. "download_quality", "theme_accent", "notif_master")
-- - value: the setting value as a string (serialized)
-- - type: the value type for deserialization (bool/int/long/float/string/set)
-- - category: grouping for backup/restore UI (download/player/appearance/notifications/general)
-- - updated_at: last change timestamp
--
-- Future-proofing: adding a new setting = one INSERT. No schema changes needed.
-- ============================================================================

CREATE TABLE IF NOT EXISTS app_settings (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL,
    type TEXT NOT NULL DEFAULT 'string',
    category TEXT NOT NULL DEFAULT 'general',
    updated_at INTEGER NOT NULL
);

-- ── Queries ──

getSetting:
SELECT * FROM app_settings WHERE key = :key;

getAllSettings:
SELECT * FROM app_settings ORDER BY category, key;

getSettingsByCategory:
SELECT * FROM app_settings WHERE category = :category ORDER BY key;

upsertSetting:
INSERT OR REPLACE INTO app_settings(key, value, type, category, updated_at)
VALUES (:key, :value, :type, :category, :updatedAt);

deleteSetting:
DELETE FROM app_settings WHERE key = :key;

deleteAllSettings:
DELETE FROM app_settings;
