-- ============================================================================
-- Content Identity System (Phase C) — restructured per PLAN v2 (D-198)
-- ============================================================================
-- Changes from v1:
--   - content → main_entry (renamed for clarity)
--   - anilist_detail + extension_detail + other_source_detail → content_details (merged)
--   - description column dropped from main_entry (was dead — read from content_details)
--   - display_source values: 'data_source' | 'extension' (axis-level, not source-name-level)
-- ============================================================================

-- ── Lookup: data_sources ──────────────────────────────────────────────────
-- Metadata / tracking sources (AniList, TMDB, Kitsu, MAL).
-- Seeded once at first launch. User never edits — updated via app updates.
CREATE TABLE IF NOT EXISTS data_source (
    id INTEGER NOT NULL PRIMARY KEY UNIQUE,
    name TEXT NOT NULL UNIQUE,
    display_name TEXT NOT NULL,
    type TEXT NOT NULL DEFAULT 'metadata',
    created_at INTEGER NOT NULL
);

-- ── Lookup: systems ───────────────────────────────────────────────────────
-- Extension systems (Aniyomi, CloudStream, Sora, MangaYomi).
-- Seeded once at first launch. User never edits — updated via app updates.
CREATE TABLE IF NOT EXISTS system (
    id INTEGER NOT NULL PRIMARY KEY UNIQUE,
    name TEXT NOT NULL UNIQUE,
    display_name TEXT NOT NULL,
    package_prefix TEXT,
    created_at INTEGER NOT NULL
);

-- ── Main: main_entry ──────────────────────────────────────────────────────
-- The central identity record. One row per piece of content (anime, manga, novel).
-- mainId = stable UUID (never changes). contentId = structured string (changes on switch).
--
-- D-189: `extension_id` stores the Aniyomi INTERNAL source.id (plain INTEGER, NOT a FK).
-- D-192: `content_ext` + `content_ext_repo` tables DROPPED (dead code).
-- D-198: Renamed from `content` → `main_entry` for clarity (avoids android.content.* collision).
-- D-198: `description` column DROPPED (was dead — readers now use content_details.data_synopsis).
-- D-198: `extension_repo_id` KEPT per user directive (will be wired up later).
-- D-198: `display_source` values migrated to axis-level: 'data_source' | 'extension'.
--        (Was source-name-level: 'anilist' | 'extension'. 'anilist' → 'data_source' on rebuild.)
--
-- Denormalized extension fields (extension_id, source_id, anime_url) are KEPT on
-- main_entry for the hot getMainEntryByExtension lookup (avoids a JOIN on every
-- extension-source open). The authoritative extension metadata lives in content_details.
CREATE TABLE IF NOT EXISTS main_entry (
    main_id TEXT NOT NULL PRIMARY KEY,
    content_id TEXT NOT NULL,
    title TEXT NOT NULL,
    content_type TEXT NOT NULL DEFAULT 'anime',
    content_format TEXT NOT NULL DEFAULT 'video',
    data_source_id INTEGER,
    system_id INTEGER,
    extension_repo_id INTEGER,
    extension_id INTEGER,
    source_id INTEGER,
    anime_url TEXT,
    display_source TEXT NOT NULL DEFAULT 'extension',
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    FOREIGN KEY (data_source_id) REFERENCES data_source(id) ON DELETE SET NULL,
    FOREIGN KEY (system_id) REFERENCES system(id) ON DELETE SET NULL
);

CREATE INDEX IF NOT EXISTS idx_main_entry_content_id ON main_entry(content_id);
CREATE INDEX IF NOT EXISTS idx_main_entry_extension_url ON main_entry(extension_id, anime_url);

-- ── Detail: content_details ───────────────────────────────────────────────
-- Unified content metadata. One row per content (1:1 with main_entry).
-- Merges: anilist_detail + extension_detail + other_source_detail + anime_metadata_cache.
--
-- Two axes in one row (distinguished by column prefixes):
--   data_* — data-source metadata (AniList now; Kitsu/MAL/TMDB future)
--   ext_*  — extension metadata (Aniyomi now; CloudStream/Sora/MangaYomi future)
--
-- Each axis is independently switchable via updateDataSourceAxis / updateExtensionAxis.
-- Each axis is independently unlinkable via clearDataSourceAxis / clearExtensionAxis.
-- All axis columns are NULLABLE — NULL means "that axis is not linked."
--
-- Discriminators:
--   data_source_type: 'anilist' | 'kitsu' | 'mal' | 'tmdb' | NULL (NULL = no data source linked)
--   extension_type:   'aniyomi' | 'cloudstream' | 'sora' | 'mangayomi' | NULL (NULL = no extension linked)
--
-- extra_json columns hold source-specific extras (id_mal, trailer_url, age_rating, etc.)
-- parsed via DataSourceExtras / ExtensionExtras typed accessors (ignoreUnknownKeys = true).
--
-- D-198: data_episodes is nullable — NULL for manga/novels (AniList doesn't track manga
-- chapters the same way). Manga chapter/volume counts go in ext_extra_json when manga
-- support is added. Zero schema change needed.
CREATE TABLE IF NOT EXISTS content_details (
    main_id TEXT NOT NULL PRIMARY KEY,

    -- ── Data-source (metadata) axis ──
    data_source_type   TEXT,
    data_source_ref_id TEXT,
    data_score          INTEGER,
    data_episodes       INTEGER,
    data_season         TEXT,
    data_season_year    INTEGER,
    data_status         TEXT,
    data_genres         TEXT,
    data_synopsis       TEXT,
    data_cover_url      TEXT,
    data_banner_url     TEXT,
    data_extra_json     TEXT,
    data_updated_at     INTEGER,

    -- ── Extension (episode source) axis ──
    extension_type      TEXT,
    extension_id        TEXT,
    source_id           INTEGER,
    anime_url           TEXT,
    ext_description     TEXT,
    ext_genres          TEXT,
    ext_status          TEXT,
    ext_author          TEXT,
    ext_artist          TEXT,
    ext_thumbnail_url   TEXT,
    ext_extra_json      TEXT,
    ext_updated_at      INTEGER,

    -- ── D-223: Adaptive color ──
    -- ARGB int (0xFFRRGGBB) extracted from the cover image via Palette API.
    -- NULL = not yet extracted (use default app accent). Stored once, reused.
    cover_accent_argb   INTEGER,

    FOREIGN KEY (main_id) REFERENCES main_entry(main_id) ON DELETE CASCADE
);

-- Partial index for the AniList hot path (getMainEntryByAniListId).
CREATE INDEX IF NOT EXISTS idx_content_details_data_ref
    ON content_details(data_source_ref_id)
    WHERE data_source_type = 'anilist';

-- Generic data-source reverse lookup (for future Kitsu/MAL/TMDB).
CREATE INDEX IF NOT EXISTS idx_content_details_data_source_ref
    ON content_details(data_source_type, data_source_ref_id);

-- ============================================================================
-- Queries: data_source
-- ============================================================================
getDataSourceByName:
SELECT * FROM data_source WHERE name = :name;

getAllDataSources:
SELECT * FROM data_source ORDER BY name ASC;

insertDataSource:
INSERT OR IGNORE INTO data_source(name, display_name, type, created_at)
VALUES (:name, :displayName, :type, :createdAt);

-- ============================================================================
-- Queries: system
-- ============================================================================
getSystemByName:
SELECT * FROM system WHERE name = :name;

getAllSystems:
SELECT * FROM system ORDER BY name ASC;

insertSystem:
INSERT OR IGNORE INTO system(name, display_name, package_prefix, created_at)
VALUES (:name, :displayName, :packagePrefix, :createdAt);

-- ============================================================================
-- Queries: main_entry
-- ============================================================================
getMainEntryByMainId:
SELECT * FROM main_entry WHERE main_id = :mainId;

getMainEntryByAniListId:
SELECT m.* FROM main_entry m
JOIN content_details d ON m.main_id = d.main_id
WHERE d.data_source_type = 'anilist' AND d.data_source_ref_id = :anilistId
LIMIT 1;

getMainEntryByExtension:
SELECT * FROM main_entry
WHERE extension_id = :extensionId AND anime_url = :animeUrl
LIMIT 1;

getMainEntryByContentId:
SELECT * FROM main_entry WHERE content_id = :contentId;

insertMainEntry:
INSERT OR REPLACE INTO main_entry(
    main_id, content_id, title, content_type, content_format,
    data_source_id, system_id, extension_repo_id, extension_id, source_id,
    anime_url, display_source, created_at, updated_at
) VALUES (
    :mainId, :contentId, :title, :contentType, :contentFormat,
    :dataSourceId, :systemId, :extensionRepoId, :extensionId, :sourceId,
    :animeUrl, :displaySource, :createdAt, :updatedAt
);

updateMainEntryContentId:
UPDATE main_entry SET content_id = :contentId, updated_at = :updatedAt
WHERE main_id = :mainId;

updateMainEntryTitle:
UPDATE main_entry SET title = :title, updated_at = :updatedAt
WHERE main_id = :mainId;

updateMainEntryDisplaySource:
UPDATE main_entry SET display_source = :displaySource, updated_at = :updatedAt
WHERE main_id = :mainId;

updateMainEntrySources:
UPDATE main_entry SET
    data_source_id = :dataSourceId,
    system_id = :systemId,
    extension_repo_id = :extensionRepoId,
    extension_id = :extensionId,
    source_id = :sourceId,
    anime_url = :animeUrl,
    content_id = :contentId,
    updated_at = :updatedAt
WHERE main_id = :mainId;

deleteMainEntry:
DELETE FROM main_entry WHERE main_id = :mainId;

-- ============================================================================
-- Queries: content_details
-- ============================================================================
getContentDetails:
SELECT * FROM content_details WHERE main_id = :mainId;

getMainEntryByDataSourceRef:
SELECT m.* FROM main_entry m
JOIN content_details d ON m.main_id = d.main_id
WHERE d.data_source_type = :sourceType AND d.data_source_ref_id = :sourceRefId
LIMIT 1;

upsertContentDetails:
INSERT OR REPLACE INTO content_details(
    main_id,
    data_source_type, data_source_ref_id, data_score, data_episodes,
    data_season, data_season_year, data_status, data_genres, data_synopsis,
    data_cover_url, data_banner_url, data_extra_json, data_updated_at,
    extension_type, extension_id, source_id, anime_url,
    ext_description, ext_genres, ext_status, ext_author, ext_artist,
    ext_thumbnail_url, ext_extra_json, ext_updated_at,
    cover_accent_argb
) VALUES (
    :mainId,
    :dataSourceType, :dataSourceRefId, :dataScore, :dataEpisodes,
    :dataSeason, :dataSeasonYear, :dataStatus, :dataGenres, :dataSynopsis,
    :dataCoverUrl, :dataBannerUrl, :dataExtraJson, :dataUpdatedAt,
    :extensionType, :extensionId, :sourceId, :animeUrl,
    :extDescription, :extGenres, :extStatus, :extAuthor, :extArtist,
    :extThumbnailUrl, :extExtraJson, :extUpdatedAt,
    :coverAccentArgb
);

updateDataSourceAxis:
UPDATE content_details SET
    data_source_type = :dataSourceType,
    data_source_ref_id = :dataSourceRefId,
    data_score = :dataScore,
    data_episodes = :dataEpisodes,
    data_season = :dataSeason,
    data_season_year = :dataSeasonYear,
    data_status = :dataStatus,
    data_genres = :dataGenres,
    data_synopsis = :dataSynopsis,
    data_cover_url = :dataCoverUrl,
    data_banner_url = :dataBannerUrl,
    data_extra_json = :dataExtraJson,
    data_updated_at = :dataUpdatedAt
WHERE main_id = :mainId;

updateExtensionAxis:
UPDATE content_details SET
    extension_type = :extensionType,
    extension_id = :extensionId,
    source_id = :sourceId,
    anime_url = :animeUrl,
    ext_description = :extDescription,
    ext_genres = :extGenres,
    ext_status = :extStatus,
    ext_author = :extAuthor,
    ext_artist = :extArtist,
    ext_thumbnail_url = :extThumbnailUrl,
    ext_extra_json = :extExtraJson,
    ext_updated_at = :extUpdatedAt
WHERE main_id = :mainId;

clearDataSourceAxis:
UPDATE content_details SET
    data_source_type = NULL,
    data_source_ref_id = NULL,
    data_score = NULL,
    data_episodes = NULL,
    data_season = NULL,
    data_season_year = NULL,
    data_status = NULL,
    data_genres = NULL,
    data_synopsis = NULL,
    data_cover_url = NULL,
    data_banner_url = NULL,
    data_extra_json = NULL,
    data_updated_at = NULL
WHERE main_id = :mainId;

clearExtensionAxis:
UPDATE content_details SET
    extension_type = NULL,
    extension_id = NULL,
    source_id = NULL,
    anime_url = NULL,
    ext_description = NULL,
    ext_genres = NULL,
    ext_status = NULL,
    ext_author = NULL,
    ext_artist = NULL,
    ext_thumbnail_url = NULL,
    ext_extra_json = NULL,
    ext_updated_at = NULL
WHERE main_id = :mainId;

deleteContentDetails:
DELETE FROM content_details WHERE main_id = :mainId;

getAllContentDetails:
SELECT * FROM content_details;

-- D-223: Update the adaptive cover accent color (extracted from cover image).
updateCoverAccentArgb:
UPDATE content_details SET cover_accent_argb = :argb WHERE main_id = :mainId;
