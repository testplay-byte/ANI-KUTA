-- Extensions tables
-- Per APP/ani-kuta/DOCUMENTATION/database/extensions.md

-- Installed extension sources on the device
CREATE TABLE IF NOT EXISTS installed_source (
    ecosystem TEXT NOT NULL,
    source_id TEXT NOT NULL,
    name TEXT NOT NULL,
    version TEXT NOT NULL,
    package_name TEXT NOT NULL,
    signature_fingerprint TEXT,
    is_enabled INTEGER NOT NULL DEFAULT 1,
    installed_at INTEGER NOT NULL,
    last_updated_at INTEGER,
    PRIMARY KEY (ecosystem, source_id)
);

CREATE INDEX IF NOT EXISTS idx_installed_source_package ON installed_source(package_name);

-- Extension repositories (NO default repos — user adds their own)
CREATE TABLE IF NOT EXISTS extension_repo (
    ecosystem TEXT NOT NULL,
    url TEXT NOT NULL,
    name TEXT NOT NULL,
    added_at INTEGER NOT NULL,
    PRIMARY KEY (ecosystem, url)
);

-- Queries for installed_source
upsertInstalledSource:
INSERT OR REPLACE INTO installed_source(
    ecosystem, source_id, name, version, package_name,
    signature_fingerprint, is_enabled, installed_at, last_updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

getInstalledSource:
SELECT * FROM installed_source WHERE ecosystem = ? AND source_id = ?;

getAllInstalledSources:
SELECT * FROM installed_source ORDER BY name ASC;

getInstalledSourcesByEcosystem:
SELECT * FROM installed_source WHERE ecosystem = ? ORDER BY name ASC;

deleteInstalledSource:
DELETE FROM installed_source WHERE ecosystem = ? AND source_id = ?;

setEnabled:
UPDATE installed_source SET is_enabled = ? WHERE ecosystem = ? AND source_id = ?;

-- Queries for extension_repo
upsertExtensionRepo:
INSERT OR REPLACE INTO extension_repo(ecosystem, url, name, added_at) VALUES (?, ?, ?, ?);

getAllExtensionRepos:
SELECT * FROM extension_repo ORDER BY added_at DESC;

getExtensionReposByEcosystem:
SELECT * FROM extension_repo WHERE ecosystem = ? ORDER BY added_at DESC;

deleteExtensionRepo:
DELETE FROM extension_repo WHERE ecosystem = ? AND url = ?;
