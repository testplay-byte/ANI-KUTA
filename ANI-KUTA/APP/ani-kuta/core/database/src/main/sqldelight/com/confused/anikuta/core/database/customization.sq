-- User customization table
-- Per APP/ani-kuta/DOCUMENTATION/database/customization.md
-- D-046: User can override metadata (custom thumbnails, titles, descriptions).

CREATE TABLE IF NOT EXISTS user_customization (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    content_key TEXT NOT NULL,
    episode_key TEXT,
    custom_title TEXT,
    custom_thumbnail TEXT,
    custom_description TEXT,
    updated_at INTEGER NOT NULL
);

-- Partial unique indexes (SQLite treats NULL as distinct in UNIQUE — S1 fix pattern)
-- One content-level override per content (episode_key IS NULL)
CREATE UNIQUE INDEX IF NOT EXISTS idx_custom_unique_content
    ON user_customization(content_key)
    WHERE episode_key IS NULL;

-- One episode-level override per episode (episode_key IS NOT NULL)
CREATE UNIQUE INDEX IF NOT EXISTS idx_custom_unique_episode
    ON user_customization(episode_key)
    WHERE episode_key IS NOT NULL;

-- Upsert content-level override
upsertContentCustomization:
INSERT OR REPLACE INTO user_customization(
    content_key, episode_key, custom_title, custom_thumbnail, custom_description, updated_at
) VALUES (?, NULL, ?, ?, ?, ?);

-- Upsert episode-level override
upsertEpisodeCustomization:
INSERT OR REPLACE INTO user_customization(
    content_key, episode_key, custom_title, custom_thumbnail, custom_description, updated_at
) VALUES (?, ?, ?, ?, ?, ?);

-- Get content-level override
getContentCustomization:
SELECT * FROM user_customization
WHERE content_key = ? AND episode_key IS NULL;

-- Get episode-level override
getEpisodeCustomization:
SELECT * FROM user_customization
WHERE episode_key = ?;

-- Get all overrides for a content (both content-level + episode-level)
getAllCustomizationsForContent:
SELECT * FROM user_customization
WHERE content_key = ?;

-- Delete content-level override
deleteContentCustomization:
DELETE FROM user_customization
WHERE content_key = ? AND episode_key IS NULL;

-- Delete episode-level override
deleteEpisodeCustomization:
DELETE FROM user_customization
WHERE episode_key = ?;
