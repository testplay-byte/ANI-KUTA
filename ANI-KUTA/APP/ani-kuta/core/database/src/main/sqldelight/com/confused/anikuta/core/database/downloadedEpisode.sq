-- ──────────────────────────────────────────────────────────────────────────
-- Downloaded episode files on disk (v2 — re-keyed by mainId + episodeKey)
-- Per AGENT-CONTEXT/download-research/11-db-schema.md §3.2
-- ──────────────────────────────────────────────────────────────────────────
--
-- This table is a CACHE/INDEX of what's on disk. The SOURCE OF TRUTH for
-- reinstall recognition is the data.json file in each content folder
-- (see 04-storage-paths.md §5). The DownloadScanner reconciles this table
-- with the disk state on startup.
--
-- REVIEW-5 M1+M2: this is the canonical v1 schema (edited directly — no .sqm
-- migration file). Existing dev installs must wipe app data once.

CREATE TABLE IF NOT EXISTS downloaded_episode (
    -- ── Content identity (re-keyed per D.0) ──
    main_id TEXT NOT NULL,
    episode_key TEXT NOT NULL,

    -- ── Episode metadata (denormalized for UI display without a JOIN) ──
    content_id TEXT NOT NULL,
    content_title TEXT NOT NULL,
    episode_number REAL NOT NULL,
    episode_name TEXT NOT NULL,
    cover_url TEXT,
    cover_color TEXT,

    -- ── File metadata ──
    file_path TEXT NOT NULL,       -- content:// URI to the published video file
    file_size INTEGER NOT NULL,
    quality TEXT,
    video_uri TEXT,                -- content:// URI (same as file_path — kept for clarity)
    subtitle_uris TEXT,            -- JSON: List<String> (content:// URIs)

    -- ── Source tracking ──
    source_id INTEGER,
    video_server TEXT,
    video_audio TEXT,

    downloaded_at INTEGER NOT NULL,

    PRIMARY KEY (main_id, episode_key)
);

-- Fast lookup by mainId (for "is this content downloaded?" + library badges).
CREATE INDEX IF NOT EXISTS idx_downloaded_episode_main
    ON downloaded_episode(main_id);

-- ── Queries ────────────────────────────────────────────────────────────────

insertDownloadedEpisode:
INSERT OR REPLACE INTO downloaded_episode(
    main_id, episode_key, content_id, content_title, episode_number, episode_name,
    cover_url, cover_color, file_path, file_size, quality, video_uri, subtitle_uris,
    source_id, video_server, video_audio, downloaded_at
) VALUES (
    :main_id, :episode_key, :content_id, :content_title, :episode_number, :episode_name,
    :cover_url, :cover_color, :file_path, :file_size, :quality, :video_uri, :subtitle_uris,
    :source_id, :video_server, :video_audio, :downloaded_at
);

getDownloadedEpisode:
SELECT * FROM downloaded_episode
WHERE main_id = :main_id AND episode_key = :episode_key;

getDownloadedEpisodesByMainId:
SELECT * FROM downloaded_episode
WHERE main_id = :main_id
ORDER BY episode_number ASC;

-- REVIEW-5 M3: uses MAX(...) for bare columns (consistent with downloadQueue.sq).
getDownloadedMainIds:
SELECT main_id, MAX(content_title) AS content_title, MAX(cover_url) AS cover_url,
       MAX(cover_color) AS cover_color, COUNT(*) AS episode_count
FROM downloaded_episode
GROUP BY main_id
ORDER BY MAX(content_title) ASC;

getAllDownloadedEpisodes:
SELECT * FROM downloaded_episode ORDER BY downloaded_at DESC;

isEpisodeDownloaded:
SELECT EXISTS(SELECT 1 FROM downloaded_episode
    WHERE main_id = :main_id AND episode_key = :episode_key);

isContentDownloaded:
SELECT EXISTS(SELECT 1 FROM downloaded_episode WHERE main_id = :main_id);

getDownloadedEpisodeCount:
SELECT COUNT(*) FROM downloaded_episode WHERE main_id = :main_id;

deleteDownloadedEpisode:
DELETE FROM downloaded_episode
WHERE main_id = :main_id AND episode_key = :episode_key;

deleteDownloadedEpisodesByMainId:
DELETE FROM downloaded_episode WHERE main_id = :main_id;

-- REVIEW-5 M7: update contentId when the user switches sources.
updateDownloadedContentId:
UPDATE downloaded_episode
SET content_id = :content_id
WHERE main_id = :main_id;

-- Orphan cleanup is done programmatically by DownloadScanner using
-- deleteDownloadedEpisodesByMainId (SQLDelight doesn't support IN (:list)).
