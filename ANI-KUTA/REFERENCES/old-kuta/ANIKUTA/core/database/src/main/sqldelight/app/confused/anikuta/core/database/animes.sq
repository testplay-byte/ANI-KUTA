-- animes.sq — Anime table with two-tier identity (ADR-050) + status-tracking (ADR-024) + library columns
--
-- Schema version 3 (after 2.sqm migration). See `_ARCHITECTURE_PLAN/proposals/01a_refined_id_system.md`.
--
-- Identity columns (ADR-050):
--   local_id   — Tier 1 per-source identity: "<system>:<extensionId>:<sourceContentId>"
--   content_id — Tier 2 per-content grouping: "<providerKey>:<remoteId>" (or = local_id fallback)
-- Both are nullable during the transition (backfilled on first launch post-migration).

CREATE TABLE animes (
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    url TEXT NOT NULL,
    title TEXT NOT NULL,
    artist TEXT,
    author TEXT,
    description TEXT,
    genre TEXT,           -- comma-separated
    cover_url TEXT,
    status INTEGER NOT NULL,    -- 0=unknown, 1=ongoing, 2=completed, ...
    thumbnail_url TEXT,
    favorite INTEGER NOT NULL DEFAULT 0,
    source_id INTEGER NOT NULL,
    date_added INTEGER NOT NULL,
    viewer_flags INTEGER NOT NULL DEFAULT 0,
    next_update INTEGER NOT NULL DEFAULT 0,
    update_strategy INTEGER NOT NULL DEFAULT 0,
    cover_last_modified INTEGER NOT NULL DEFAULT 0,

    -- Status-tracking columns (ADR-024)
    release_date INTEGER,            -- when the anime was first released
    last_refresh INTEGER NOT NULL DEFAULT 0,    -- last time refreshed from source
    last_metadata_fetch INTEGER,     -- last time metadata was fetched (AniList/ext)
    next_episode_check INTEGER,      -- when to next check for new episodes (ADR-014)

    -- Library columns (Phase A — library page)
    anilist_id INTEGER,              -- AniList media ID (nullable for non-AniList entries)
    cover_color TEXT,                -- hex color extracted from cover (e.g. "#B1F256")
    score REAL,                      -- AniList average score (0-100)
    total_episodes INTEGER,          -- AniList total episodes count
    last_watched INTEGER NOT NULL DEFAULT 0,  -- epoch ms of last watch activity
    next_airing_episode INTEGER,     -- AniList next airing episode number (for released-episode count)

    -- ═══ Two-tier identity (ADR-050) ═══
    local_id TEXT,                   -- Tier 1: "<system>:<extensionId>:<sourceContentId>" | "<providerKey>:<remoteId>"
    content_id TEXT,                 -- Tier 2: "<providerKey>:<remoteId>" (or = local_id fallback)

    -- ═══ Source provenance (ADR-050 §5.1) ═══
    system TEXT,                     -- "aniyomi" | "cloudstream" | ... (ExtensionSystem.key)
    repo_url TEXT,                   -- extension repo base URL (nullable if installed from APK)
    repo_name TEXT,                  -- human-readable repo name
    extension_pkg_name TEXT,         -- e.g. "eu.kanade.tachiyomi.animeextension.en.gogoanime"
    extension_name TEXT,             -- human-readable extension name
    extension_version_name TEXT,     -- e.g. "1.4.3"
    extension_version_code INTEGER,
    extension_lang TEXT,             -- e.g. "en"
    is_nsfw INTEGER NOT NULL DEFAULT 0,  -- extension NSFW flag
    source_name TEXT,                -- the source's display name (distinct from extension name)

    -- ═══ Bookkeeping ═══
    discovered_at INTEGER NOT NULL DEFAULT 0,    -- when this local_id was first created
    last_resolved_at INTEGER NOT NULL DEFAULT 0, -- when content_id was last re-resolved
    link_confidence INTEGER NOT NULL DEFAULT 0   -- 0=none, 1=auto-matched, 2=user-confirmed
);

-- ═══ Indexes ═══

-- Partial unique index: anilist_id is unique when not null
CREATE UNIQUE INDEX IF NOT EXISTS idx_animes_anilist_id
ON animes(anilist_id) WHERE anilist_id IS NOT NULL;

-- local_id is unique when not null (one row per (anime, source))
CREATE UNIQUE INDEX IF NOT EXISTS idx_animes_local_id
ON animes(local_id) WHERE local_id IS NOT NULL;

-- content_id is NOT unique (multiple rows/sources can share a content_id)
CREATE INDEX IF NOT EXISTS idx_animes_content_id
ON animes(content_id) WHERE content_id IS NOT NULL;

-- (source_id, url) uniqueness for unlinked extension entries
CREATE UNIQUE INDEX IF NOT EXISTS idx_animes_source_url
ON animes(source_id, url) WHERE source_id != 0;

-- ═══ Existing queries (unchanged — backward compat) ═══

selectAll:
SELECT * FROM animes;

selectById:
SELECT * FROM animes WHERE _id = :id;

selectByAnilistId:
SELECT * FROM animes WHERE anilist_id = :anilistId;

selectIdByAnilistId:
SELECT _id FROM animes WHERE anilist_id = :anilistId;

selectFavorites:
SELECT * FROM animes WHERE favorite = 1 ORDER BY title COLLATE NOCASE;

selectBySource:
SELECT * FROM animes WHERE source_id = :sourceId AND favorite = 1;

selectBySourceAndUrl:
SELECT * FROM animes WHERE source_id = :sourceId AND url = :url LIMIT 1;

searchByName:
SELECT * FROM animes WHERE title LIKE '%' || :query || '%' COLLATE NOCASE;

insert:
INSERT INTO animes (
    url, title, artist, author, description, genre, cover_url, status,
    thumbnail_url, favorite, source_id, date_added, viewer_flags,
    next_update, update_strategy, cover_last_modified,
    release_date, last_refresh, last_metadata_fetch, next_episode_check,
    anilist_id, cover_color, score, total_episodes, last_watched, next_airing_episode
) VALUES (
    :url, :title, :artist, :author, :description, :genre, :coverUrl, :status,
    :thumbnailUrl, :favorite, :sourceId, :dateAdded, :viewerFlags,
    :nextUpdate, :updateStrategy, :coverLastModified,
    :releaseDate, :lastRefresh, :lastMetadataFetch, :nextEpisodeCheck,
    :anilistId, :coverColor, :score, :totalEpisodes, :lastWatched, :nextAiringEpisode
);

update:
UPDATE animes SET
    url = :url, title = :title, artist = :artist, author = :author,
    description = :description, genre = :genre, cover_url = :coverUrl,
    status = :status, thumbnail_url = :thumbnailUrl,
    favorite = :favorite, viewer_flags = :viewerFlags,
    next_update = :nextUpdate, update_strategy = :updateStrategy,
    cover_last_modified = :coverLastModified,
    release_date = :releaseDate, last_refresh = :lastRefresh,
    last_metadata_fetch = :lastMetadataFetch, next_episode_check = :nextEpisodeCheck,
    anilist_id = :anilistId, cover_color = :coverColor,
    score = :score, total_episodes = :totalEpisodes, last_watched = :lastWatched,
    next_airing_episode = :nextAiringEpisode
WHERE _id = :id;

updateFavorite:
UPDATE animes SET favorite = :favorite, date_added = :dateAdded WHERE _id = :id;

updateFavoriteByAnilistId:
UPDATE animes SET favorite = :favorite, date_added = :dateAdded WHERE anilist_id = :anilistId;

updateLastRefresh:
UPDATE animes SET last_refresh = :lastRefresh WHERE _id = :id;

updateLastMetadataFetch:
UPDATE animes SET last_metadata_fetch = :lastMetadataFetch WHERE _id = :id;

updateNextEpisodeCheck:
UPDATE animes SET next_episode_check = :nextEpisodeCheck WHERE _id = :id;

updateLastWatched:
UPDATE animes SET last_watched = :lastWatched WHERE _id = :id;

updateLastWatchedByAnilistId:
UPDATE animes SET last_watched = :lastWatched WHERE anilist_id = :anilistId;

-- Clears the AniList association on a row (used by AppController.unlinkFromAniList).
-- The row stays in the library (favorite flag untouched) but becomes extension-only.
clearAnilistId:
UPDATE animes SET anilist_id = NULL WHERE _id = :id;

-- Sets the AniList association on an existing row WITHOUT touching favorite /
-- category membership (used by ExtensionDetailsProvider.persistEpisodes when a
-- previously-unlinked extension-only row is being linked to AniList for the
-- first time). The companion of [clearAnilistId].
updateAnilistId:
UPDATE animes SET anilist_id = :anilistId WHERE _id = :id;

updateAnilistMetadataByAnilistId:
UPDATE animes SET
    title = :title,
    cover_url = :coverUrl,
    cover_color = :coverColor,
    score = :score,
    total_episodes = :totalEpisodes,
    next_airing_episode = :nextAiringEpisode
WHERE anilist_id = :anilistId;

-- Updates only the cover URL + cover color (used when the user switches the
-- per-anime data-source preference to Extension — the library should reflect
-- the extension's cover, not AniList's). Does NOT touch title/score/etc.
updatePreferredCoverByAnilistId:
UPDATE animes SET
    cover_url = :coverUrl,
    cover_color = :coverColor
WHERE anilist_id = :anilistId;

-- Same, keyed by sourceId + url (for unlinked extension anime).
updatePreferredCoverBySourceAndUrl:
UPDATE animes SET
    cover_url = :coverUrl,
    cover_color = :coverColor
WHERE source_id = :sourceId AND url = :url;

lastInsertedRowId:
SELECT last_insert_rowid();

delete:
DELETE FROM animes WHERE _id = :id;

-- ═══ NEW: Identity queries (ADR-050) ═══

selectByLocalId:
SELECT * FROM animes WHERE local_id = :localId LIMIT 1;

selectByContentId:
SELECT * FROM animes WHERE content_id = :contentId;

selectIdByContentId:
SELECT _id FROM animes WHERE content_id = :contentId LIMIT 1;

-- All rows that are missing local_id/content_id (for the backfill on first launch).
selectRowsMissingIdentity:
SELECT * FROM animes WHERE local_id IS NULL OR content_id IS NULL;

-- Set the local_id + content_id for a row (used by the backfill + on new upserts).
updateIdentity:
UPDATE animes SET
    local_id = :localId,
    content_id = :contentId,
    last_resolved_at = :lastResolvedAt
WHERE _id = :id;

-- Set the full source provenance for a row.
updateProvenance:
UPDATE animes SET
    system = :system,
    repo_url = :repoUrl,
    repo_name = :repoName,
    extension_pkg_name = :extensionPkgName,
    extension_name = :extensionName,
    extension_version_name = :extensionVersionName,
    extension_version_code = :extensionVersionCode,
    extension_lang = :extensionLang,
    is_nsfw = :isNsfw,
    source_name = :sourceName,
    discovered_at = :discoveredAt,
    link_confidence = :linkConfidence
WHERE _id = :id;

-- Update only the content_id (used when a provider link is added/removed — the
-- ContentIdMigrator re-derives the content_id, then re-keys cross-cutting stores).
updateContentId:
UPDATE animes SET
    content_id = :contentId,
    last_resolved_at = :lastResolvedAt
WHERE _id = :id;

-- Update source_id + url on an existing library row (used when switching
-- extension sources — preserves _id, favorite, category membership, etc.).
updateSourceAndUrl:
UPDATE animes SET
    source_id = :sourceId,
    url = :url
WHERE _id = :id;

-- ═══ Fix 3 (SOURCE-SWITCH-FIXES) ═══
-- Overwrites title/description/genre/cover_url/cover_color/status/artist/author
-- on an existing anime row from the extension's (enriched) SAnime data.
--
-- Used by ExtensionDetailsProvider.persistEpisodes to overwrite stale AniList
-- metadata when the extension re-fetches (e.g. after unlink, after
-- switchExtension, after pull-to-refresh). Called for BOTH newly-inserted AND
-- existing rows so the row always reflects the extension's view of the anime.
--
-- NOTE: only called when sAnime.initialized == true (i.e. getAnimeDetails was
-- called and the SAnime has full metadata). The loadEpisodes() path (used by
-- reloadEpisodesOnly in AniList mode) builds a partial SAnime with just
-- url+title — calling this query there would null out description/genre/etc.
updateMetadataFromExtension:
UPDATE animes SET
    title = :title,
    description = :description,
    genre = :genre,
    cover_url = :coverUrl,
    cover_color = :coverColor,
    status = :status,
    artist = :artist,
    author = :author
WHERE _id = :id;
