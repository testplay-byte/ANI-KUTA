# Normalize line endings — critical for gradlew (POSIX sh, must be LF)
* text=auto eol=lf

# Windows-only scripts stay CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Explicit gradlew rules (belt and suspenders)
gradlew text eol=lf
gradlew.bat text eol=crlf

# Binaries — never normalize
*.jar binary
*.png binary
*.jpg binary
*.webp binary
*.keystore binary
*.jks binary
